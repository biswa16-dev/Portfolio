    <style>
      #hero {
        .banner {
          display: flex;
          justify-content: center;
        }

        .banner_btn_container {
          padding-left: 54px;
        }
      }

      @media (max-width: 991px) {
        #hero {
          padding: 15px 0px;

          .banner_btn_container {
            padding-left: 0px;
          }
        }
      }

      #banner-custom-owl-dots.owl-dots {
        /* display: grid;
      grid-template-columns: repeat(7,1fr); */
        display: flex;
        flex-wrap: nowrap;
        flex-basis: 1 1 auto;
        gap: 1%;
        place-items: center;
        margin: auto;
        min-width: 284px;
        width: 83%;
      }

      #banner-custom-owl-dots .owl-dot {
        color: white;
        cursor: pointer;
        border-radius: 5px;
        border: 1px solid transparent;
        img {
          min-width: 35px;
          width: 100%;
          max-height: 63.5px;
          object-fit: fill;
          object-position: center;
          aspect-ratio: 2/1;
          border-radius: inherit;
        }
      }
      #banner-custom-owl-dots .owl-dot.active {
        border: 1px solid #fb8133;
      }

      #floating-introducing {
        position: fixed;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 9999;
        max-width: 140px;
        border-radius: 12px;
        cursor: grab;
        user-select: none;
        animation: fi-entrance 3.4s linear both;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        overflow: visible;
      }
      @media (max-width: 768px) {
        #floating-introducing {
          max-width: 100px;
        }
      }
      #floating-introducing:hover {
        transform: translateY(-50%) scale(1.06);
      }
      #floating-introducing.dragging {
        cursor: grabbing;
        transition: none;
      }
      /* after first drag: explicit pixel coords, no centering transform needed */
      #floating-introducing.positioned {
        transform: none;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      #floating-introducing.positioned:hover {
        transform: scale(1.06);
      }
      #floating-introducing.positioned.dragging {
        transform: none;
        transition: none;
      }
      #floating-introducing.hiding {
        animation: fi-exit 0.4s cubic-bezier(0.55, 0, 1, 0.45) forwards;
      }
      #floating-introducing.positioned.hiding {
        animation: fi-exit-simple 0.4s cubic-bezier(0.55, 0, 1, 0.45) forwards;
      }
      #floating-introducing img {
        width: 100%;
        display: block;
        border-radius: 12px;
        pointer-events: none;
        animation: fi-bob 3s ease-in-out 3.4s infinite;
        filter: drop-shadow(0 16px 18px rgba(0, 0, 0, 0.35));
      }
      #floating-introducing.dragging img,
      #floating-introducing.positioned.dragging img {
        animation-play-state: paused;
        filter: drop-shadow(0 28px 28px rgba(0, 0, 0, 0.22));
      }
      #floating-introducing-close {
        position: absolute;
        top: -10px;
        right: -10px;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: none;
        background: #fff;
        color: #444;
        font-size: 13px;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition:
          background 0.18s ease,
          color 0.18s ease,
          transform 0.18s ease;
        z-index: 10000;
      }
      #floating-introducing-close:hover {
        background: #ff4d4d;
        color: #fff;
        transform: scale(1.15) rotate(90deg);
      }
      @keyframes fi-entrance {
        0% {
          opacity: 0;
          transform: translateY(calc(-50% + 110vh)) scale(0.74) rotate(0deg);
          animation-timing-function: cubic-bezier(0.4, 0, 0.55, 1);
        }
        7% {
          opacity: 0.7;
          transform: translateY(calc(-50% + 90vh)) translateX(-7px) scale(0.77)
            rotate(-3deg);
          animation-timing-function: linear;
        }
        17% {
          opacity: 1;
          transform: translateY(calc(-50% + 67vh)) translateX(-13px) scale(0.82)
            rotate(-5deg);
          animation-timing-function: linear;
        }
        28% {
          transform: translateY(calc(-50% + 47vh)) translateX(9px) scale(0.87)
            rotate(4deg);
          animation-timing-function: linear;
        }
        39% {
          transform: translateY(calc(-50% + 30vh)) translateX(-7px) scale(0.91)
            rotate(-3deg);
          animation-timing-function: linear;
        }
        50% {
          transform: translateY(calc(-50% + 17vh)) translateX(6px) scale(0.94)
            rotate(2.5deg);
          animation-timing-function: linear;
        }
        60% {
          transform: translateY(calc(-50% + 8.5vh)) translateX(-4px) scale(0.96)
            rotate(-1.5deg);
          animation-timing-function: cubic-bezier(0.25, 0, 0.35, 1);
        }
        69% {
          transform: translateY(calc(-50% + 3.8vh)) translateX(2.5px)
            scale(0.98) rotate(1deg);
          animation-timing-function: cubic-bezier(0.2, 0, 0.25, 1);
        }
        77% {
          transform: translateY(calc(-50% + 1.2vh)) translateX(-1.5px)
            scale(0.995) rotate(-0.5deg);
          animation-timing-function: cubic-bezier(0.15, 0, 0.25, 1);
        }
        84% {
          transform: translateY(calc(-50% + 0.1vh)) translateX(0.5px)
            scale(1.005) rotate(0deg);
          animation-timing-function: ease-in-out;
        }
        90% {
          transform: translateY(calc(-50% - 1.3vh)) translateX(0px) scale(1.015)
            rotate(0deg);
          animation-timing-function: ease-in-out;
        }
        94% {
          transform: translateY(calc(-50% - 0.2vh)) scale(1.008) rotate(0deg);
          animation-timing-function: ease-in-out;
        }
        97% {
          transform: translateY(calc(-50% - 0.5vh)) scale(1.003) rotate(0deg);
          animation-timing-function: ease-in-out;
        }
        100% {
          opacity: 1;
          transform: translateY(-50%) scale(1) rotate(0deg);
        }
      }
      @keyframes fi-exit {
        0% {
          opacity: 1;
          transform: translateY(-50%) scale(1);
        }
        100% {
          opacity: 0;
          transform: translateY(calc(-50% + 50px)) scale(0.45);
        }
      }
      @keyframes fi-exit-simple {
        0% {
          opacity: 1;
          transform: scale(1);
        }
        100% {
          opacity: 0;
          transform: translateY(50px) scale(0.45);
        }
      }
      @keyframes fi-bob {
        0%,
        100% {
          transform: translateY(0px);
          filter: drop-shadow(0 16px 18px rgba(0, 0, 0, 0.35));
        }
        50% {
          transform: translateY(-14px);
          filter: drop-shadow(0 30px 22px rgba(0, 0, 0, 0.15));
        }
      }
    </style>
  </head>

