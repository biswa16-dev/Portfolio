      $(window).on("load resize scroll", function () {
        $(".placementrow1").each(function () {
          var windowTop = $(window).scrollTop();
          var elementTop = $(this).offset().top;
          var leftPosition = windowTop - elementTop;
          $(this).find(".placementcard").css({ left: leftPosition });
        });
        $(".placementrow2").each(function () {
          var windowTop = $(window).scrollTop();
          var elementTop = $(this).offset().top;
          var leftPosition = windowTop - elementTop;
          $(this).find(".placementcard").css({ right: leftPosition });
        });
