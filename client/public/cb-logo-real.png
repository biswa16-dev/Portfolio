    <script>
      (function () {
        var el = document.getElementById("floating-introducing");
        var closeBtn = document.getElementById("floating-introducing-close");
        var isDragging = false;
        var hasDragged = false;
        var startX, startY, initLeft, initTop;
        var link = document.getElementById("fi-link");

        link.addEventListener("click", function (e) {
          if (hasDragged) {
            e.preventDefault();
          }
          hasDragged = false;
        });

        function getPos() {
          var rect = el.getBoundingClientRect();
          return { left: rect.left, top: rect.top };
        }

        function clamp(val, min, max) {
          return Math.max(min, Math.min(max, val));
        }

        function toFixed(el) {
          if (el.classList.contains("positioned")) return;
          // 1. Kill the animation so its fill-mode transform is gone before we measure.
          el.style.animation = "none";
          void el.offsetWidth; // force reflow — BCR below must not see the old fill-mode
          // 2. Derive center from BCR. Hover scale(1.06) shifts the edges but NEVER moves
          //    the center (default transform-origin:50% 50%), so center is always correct.
          var rect = el.getBoundingClientRect();
          var centerX = rect.left + rect.width / 2;
          var centerY = rect.top + rect.height / 2;
          // 3. Place element so its center stays exactly where it visually was.
          //    offsetWidth/Height are layout dimensions, unaffected by any CSS transform.
          el.style.left = centerX - el.offsetWidth / 2 + "px";
          el.style.top = centerY - el.offsetHeight / 2 + "px";
          el.style.right = "auto";
          el.style.bottom = "auto";
          el.classList.add("positioned");
        }

        function grabStart(el) {
          el.style.transition = "none";
          toFixed(el);
          el.classList.add("dragging");
          void el.offsetWidth;
          el.style.transition = "";
        }

        closeBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          el.style.animation = ""; // clear inline animation:none so CSS exit animation wins
          el.classList.add("hiding");
          el.addEventListener(
            "animationend",
            function () {
              el.remove();
            },
            { once: true },
          );
        });

        el.addEventListener("mousedown", function (e) {
          if (e.target === closeBtn) return;
          hasDragged = false;
          grabStart(el);
          isDragging = true;
          startX = e.clientX;
          startY = e.clientY;
          initLeft = parseFloat(el.style.left);
          initTop = parseFloat(el.style.top);
          e.preventDefault();
        });

        el.addEventListener(
          "touchstart",
          function (e) {
            if (e.target === closeBtn) return;
            e.preventDefault();
            hasDragged = false;
            grabStart(el);
            isDragging = true;
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
            initLeft = parseFloat(el.style.left);
            initTop = parseFloat(el.style.top);
          },
          { passive: false },
        );

        document.addEventListener("mousemove", function (e) {
          if (!isDragging) return;
          e.preventDefault();
          var dx = e.clientX - startX;
          var dy = e.clientY - startY;
          if (Math.abs(dx) > 3 || Math.abs(dy) > 3) hasDragged = true;
          var newLeft = clamp(
            initLeft + dx,
            0,
            window.innerWidth - el.offsetWidth,
          );
          var newTop = clamp(
            initTop + dy,
            0,
            window.innerHeight - el.offsetHeight,
          );
          el.style.left = newLeft + "px";
          el.style.top = newTop + "px";
        });

        document.addEventListener(
          "touchmove",
          function (e) {
            if (!isDragging) return;
            e.preventDefault();
            var dx = e.touches[0].clientX - startX;
            var dy = e.touches[0].clientY - startY;
            if (Math.abs(dx) > 3 || Math.abs(dy) > 3) hasDragged = true;
            var newLeft = clamp(
              initLeft + dx,
              0,
              window.innerWidth - el.offsetWidth,
            );
            var newTop = clamp(
              initTop + dy,
              0,
              window.innerHeight - el.offsetHeight,
            );
            el.style.left = newLeft + "px";
            el.style.top = newTop + "px";
          },
          { passive: false },
        );

        function stopDrag() {
          if (!isDragging) return;
          isDragging = false;
          el.classList.remove("dragging");
        }

        document.addEventListener("mouseup", stopDrag);
        document.addEventListener("touchend", stopDrag);

        el.addEventListener(
          "touchend",
          function (e) {
            if (!hasDragged && e.target !== closeBtn) {
              window.open(link.href, link.target || "_blank");
            }
          },
          { passive: true },
        );
      })();
    </script>
  </body>
</html>
